{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "auth != null",

        ".write": "auth != null && ( !data.exists() || data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || (!data.child('guestUid').exists() || data.child('guestUid').val() === null) )",

        ".validate": "$code.matches(/^[0-9]{4}$/)",

        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val() || newData.val() === auth.uid)"
        },

        "guestUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || data.val() === null || data.val() === auth.uid)"
        },

        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },

        "offer": {
          ".validate": "newData.hasChildren(['type', 'sdp']) && root.child('rooms').child($code).child('hostUid').val() === auth.uid",
          "type": { ".validate": "newData.isString()" },
          "sdp": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        },

        "answer": {
          ".validate": "newData.hasChildren(['type', 'sdp']) && root.child('rooms').child($code).child('guestUid').val() === auth.uid",
          "type": { ".validate": "newData.isString()" },
          "sdp": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        },

        "hostCandidates": {
          ".validate": "root.child('rooms').child($code).child('hostUid').val() === auth.uid || !newData.exists()",
          "$candidate": { ".validate": "newData.hasChild('candidate') || newData.hasChildren()" }
        },

        "guestCandidates": {
          ".validate": "root.child('rooms').child($code).child('guestUid').val() === auth.uid || !newData.exists()",
          "$candidate": { ".validate": "newData.hasChild('candidate') || newData.hasChildren()" }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
